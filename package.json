{
  "name": "thread-monorepo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "install:desktop": "pnpm --dir apps/desktop install --frozen-lockfile",
    "install:mobile": "pnpm --dir apps/mobile install --frozen-lockfile",
    "install:site": "pnpm --dir apps/web/site install --frozen-lockfile",
    "install:admin": "pnpm --dir apps/web/admin install --frozen-lockfile",
    "install:rms": "pnpm --dir services/rms install --frozen-lockfile",
    "dev:desktop": "pnpm --dir apps/desktop win-all",
    "dev:desktop:secure": "set THREAD_SECURE_LOGS=1&& pnpm dev:desktop",
    "dev:mobile": "pnpm --dir apps/mobile android",
    "dev:site": "pnpm --dir apps/web/site start",
    "dev:admin": "pnpm --dir apps/web/admin start",
    "build:web": "pnpm --dir apps/web/site build && pnpm --dir apps/web/admin build",
    "build:desktop": "pnpm --dir apps/desktop win-pack",
    "cert:desktop:create": "node apps/desktop/scripts/updateTrustRoot.cjs create",
    "cert:desktop:renew": "node apps/desktop/scripts/updateTrustRoot.cjs renew",
    "cert:desktop:passphrase": "node apps/desktop/scripts/generatePassphrase.cjs",
    "db:backup": "sh scripts/db-backup.sh",
    "lint:mobile": "pnpm --dir apps/mobile lint"
  }
}
