# Local-only defaults for Docker Compose. Replace all secrets before deployment.
MYSQL_DATABASE=thread
MYSQL_USER=thread
MYSQL_PASSWORD=thread-dev-password
MYSQL_ROOT_PASSWORD=thread-dev-root-password

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRE=3h
JWT_REFRESH_EXPIRE=7d

GOOGLE_OAUTH2_CLIENT_ID=local-google-oauth-disabled
GOOGLE_OAUTH2_CLIENT_SECRET=local-google-oauth-disabled
GOOGLE_OAUTH2_REDIRECT_URL=http://localhost:4033/v1/google_auth/login_callback

APP_SERVER_PORT=4033
RMS_PORT=4034
SITE_PORT=3000
ADMIN_SITE_PORT=3001
