# Local-only defaults for Docker Compose. Replace all secrets before deployment.
MYSQL_DATABASE=thread
MYSQL_USER=thread
MYSQL_PASSWORD=thread-dev-password
MYSQL_ROOT_PASSWORD=thread-dev-root-password

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRE=3h
JWT_REFRESH_EXPIRE=7d

ADMIN_ID=replace-with-admin-id
ADMIN_PASSWORD=replace-with-a-strong-admin-password

GOOGLE_OAUTH2_CLIENT_ID=local-google-oauth-disabled
GOOGLE_OAUTH2_CLIENT_SECRET=local-google-oauth-disabled
GOOGLE_OAUTH2_REDIRECT_URL=http://localhost:4033/v1/google_auth/login_callback
USE_HTTPS=false
# v2-only release. Operator must finish backfill before starting this release.
# false pauses v2 sync; it does NOT re-enable v1.
SYNC_V2_ENABLED=true
# Development/review only; does not activate accounts or migrate plaintext.
# Keep false for production until task #57 release approval.
E2EE_API_ENABLED=false
# Development/rehearsal only until the complete migration flow passes #57.
# Enabling this currently exposes prepare/status/source/cancel, not activation.
E2EE_MIGRATION_ENABLED=false
# Explicit maintenance only; receipts/tombstones are not pruned.
SYNC_LOG_PRUNE_ENABLED=false
ADMIN_APP_SERVER_ENTRY=http://localhost:4033
ADMIN_RMS_ENTRY=http://localhost:4034

APP_SERVER_PORT=4033
RMS_PORT=4034
SITE_PORT=3000
ADMIN_SITE_PORT=3001
