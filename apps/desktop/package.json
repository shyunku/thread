{
  "name": "thread",
  "author": {
    "name": "shyunku",
    "email": "whdudgns7321@gmail.com"
  },
  "version": "1.1.3",
  "description": "Cross-platform task and schedule manager for desktop",
  "main": "public/electron/core/main.js",
  "homepage": "./",
  "private": true,
  "pnpm": {
    "neverBuiltDependencies": ["better-sqlite3-multiple-ciphers"]
  },
  "allowMultipleExecution": false,
  "config": {
    "react_port": 9300,
    "scheme_version": 2,
    "root_scheme_version": 1,
    "app_server_api_version": "v1"
  },
  "scripts": {
    "build:auth-helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-auth-helper.ps1",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "line-test": "echo %npm_package_config_react_port%",
    "win-react": "set PORT=%npm_package_config_react_port% && set BROWSER=none&& pnpm start",
    "mac-react": "PORT=$npm_package_config_react_port BROWSER=none pnpm start",
    "win-electron": "set ELECTRON_START_URL=http://localhost:%npm_package_config_react_port% && set NODE_ENV=development && wait-on http://localhost:%npm_package_config_react_port% && electron .",
    "mac-electron": "export ELECTRON_START_URL=http://localhost:$npm_package_config_react_port && export NODE_ENV=development && wait-on http://localhost:$npm_package_config_react_port && electron .",
    "win-all": "concurrently \"pnpm win-react\" \"pnpm win-electron\"",
    "mac-all": "concurrently \"pnpm mac-react\" \"pnpm mac-electron\"",
    "win-pack": "pnpm build && for %i in (pnpm.cmd) do @set \"npm_execpath=%~$PATH:i\" && electron-builder build -c.extraMetadata.main=build/electron/core/main.js",
    "mac-pack": "pnpm build && electron-builder build -c.extraMetadata.main=build/electron/core/main.js"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "0.8.4",
    "tuf-js": "6.0.0",
    "libsodium-wrappers": "0.8.4",
    "cbor": "10.0.12",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "@reduxjs/toolkit": "1.9.2",
    "axios": "1.3.3",
    "bignumber.js": "9.1.1",
    "compare-versions": "6.0.0-rc.1",
    "concurrently": "7.6.0",
    "crypto": "1.0.1",
    "dmg": "0.1.0",
    "dotenv": "16.6.1",
    "electron-log": "5.0.0-beta.16",
    "electron-notarize": "1.2.2",
    "fs-extra": "11.1.1",
    "lodash": "4.17.21",
    "moment": "2.29.4",
    "progress-stream": "2.0.0",
    "react": "^18.2.0",
    "react-color": "2.19.3",
    "react-cssfx-loading": "2.1.0",
    "react-dnd": "16.0.1",
    "react-dom": "^18.2.0",
    "react-icons": "4.7.1",
    "react-loader-spinner": "5.3.4",
    "react-redux": "8.0.5",
    "react-router-dom": "6.8.1",
    "redux-persist": "6.0.0",
    "sass": "1.58.3",
    "sha256": "0.2.0",
    "socket.io-client": "4.6.0",
    "sqlite3": "5.1.4",
    "uuid": "9.0.0",
    "wait-on": "7.0.1",
    "web-vitals": "2.1.4",
    "ws": "8.13.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "13.4.0",
    "@testing-library/user-event": "13.5.0",
    "react-scripts": "5.0.1",
    "electron": "43.6.0",
    "electron-builder": "26.15.3",
    "typescript": "4.8.4"
  },
  "build": {
    "productName": "Thread",
    "appId": "kr.threadapp.desktop",
    "asar": true,
    "beforePack": "./public/electron/modules/buildAuthHelper.js",
    "afterSign": "./public/electron/modules/notarize.js",
    "publish": [
      {
        "provider": "github",
        "private": true,
        "owner": "shyunku",
        "repo": "thread"
      }
    ],
    "files": [
      "./.env.production",
      "./build/**/*",
      "./public/electron/core/main.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "./public/favicon512.ico"
    },
    "mac": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "./build/entitlements.mac.plist",
      "extendInfo": {},
      "identity": "YoungHoon Jo (PW6C6D62RX)",
      "target": [
        {
          "target": "default",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "./public/logo512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "installer.nsh"
    },
    "extraResources": [
      {
        "from": "./build/resources/",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./build/tray/",
        "to": "tray",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
