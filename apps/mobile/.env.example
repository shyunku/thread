# Copy to .env (never commit .env). Values are compiled into the JS bundle.
# The Android emulator reaches the host's localhost at 10.0.2.2.
APP_SERVER_ENDPOINT=http://10.0.2.2:4033
GOOGLE_OAUTH_WEB_CLIENT_ID=replace-with-google-web-client-id
# 1 = suppress app logs (agents must run with this; see AGENTS.md).
SECURE_LOGS=0
