# Copy to .env (never commit .env). Values are compiled into the JS bundle.
# A phone build against the production server uses .env.phone (THREAD_ENV_FILE=.env.phone):
# leave APP_SERVER_ENDPOINT out (or https://api.threadapp.kr) and set the Google web client ID.
# Without APP_SERVER_ENDPOINT the app uses https://api.threadapp.kr (production vault scope).
# For a local API server on the emulator, run `adb reverse tcp:4033 tcp:4033`
# and use localhost: plain http is accepted only for this device itself.
APP_SERVER_ENDPOINT=http://localhost:4033
# The web OAuth client the server accepts as ID-token audience (same as the desktop).
GOOGLE_OAUTH_WEB_CLIENT_ID=replace-with-google-web-client-id
# 1 = suppress app logs (agents must run with this; see AGENTS.md).
SECURE_LOGS=0
